<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="io.aosc.deb_installer.manage">
    <description>Committing system package changes (backend)</description>
    <description xml:lang="zh_CN">应用系统软件包（后端）</description>
    <message>Committing system package changes requires elevated privileges</message>
    <message xml:lang="zh_CN">应用系统软件包更改需要鉴权</message>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <!-- pkexec uses this action when launching deb-installer backend.
       auth_admin_keep ensures the auth dialog always appears. -->
  <action id="io.aosc.deb_installer.launch">
    <description>Committing system package changes</description>
    <description xml:lang="zh_CN">应用系统软件包更改</description>
    <message>Committing system package changes requires elevated privileges</message>
    <message xml:lang="zh_CN">应用系统软件包更改需要鉴权</message>
    <icon_name>io.aosc.deb_installer</icon_name>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/deb-installer</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">--backend</annotate>
  </action>
</policyconfig>
